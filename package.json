{
  "name": "recent-list",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Quick access to recently opened projects.",
  "keywords": [
    "history",
    "workspace",
    "last-opened",
    "switcher",
    "mru"
  ],
  "repository": "https://github.com/lumine-code/recent-list",
  "bugs": {
    "url": "https://github.com/lumine-code/recent-list/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "docs",
    "keymaps",
    "lib",
    "menus",
    "spec"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "backgroundTips": [
    "You can reopen a project you worked on earlier with {{ 'recent-list:toggle' | keystroke }}"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "providedServices": {
    "recent-list": {
      "description": "Provides access to the recent projects list manager",
      "versions": {
        "1.0.0": "provideRecentList"
      }
    }
  },
  "consumedServices": {
    "open-external": {
      "versions": {
        "^1.0.0": "consumeOpenExternal"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
